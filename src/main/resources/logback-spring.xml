<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracion de Logback (rubrica: uso de librerias + tratamiento seguro de la informacion).
  - Nunca se registran contrasenas ni valores de parametros SQL (org.hibernate.orm.jdbc.bind en OFF).
  - Los correos se enmascaran en el codigo con Privacidad.enmascararEmail().
  - Archivo con rotacion diaria / 10 MB y 14 dias de historial en ./logs.
-->
<configuration>
  <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n"/>

  <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>${PATRON}</pattern></encoder>
  </appender>

  <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/bella-estilo.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>logs/bella-estilo.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>200MB</totalSizeCap>
    </rollingPolicy>
    <encoder><pattern>${PATRON}</pattern></encoder>
  </appender>

  <logger name="pe.utp.peluqueria" level="INFO"/>
  <logger name="org.springframework.security" level="WARN"/>
  <logger name="org.hibernate.SQL" level="OFF"/>
  <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>

  <root level="INFO">
    <appender-ref ref="CONSOLA"/>
    <appender-ref ref="ARCHIVO"/>
  </root>
</configuration>
